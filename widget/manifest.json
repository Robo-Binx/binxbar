{
  "author": "Binx, clock face from inerthel-agi",
  "id": "com.personal.binxbar",
  "name": "Binxbar",
  "description": "Desk control panel for the Xeneon Edge: mic live/mute, Discord call status, wrong-mic fix, voice-channel bubbles with tap-to-join, stream and disconnect buttons, music and volume, brightness, clock, calendar, and a weather station with radar.",
  "version": "1.1.0",
  "min_app_version": "5.52",
  "preview_icon": "resources/icon.svg",
  "min_framework_version": "1.9.0",
  "os": [
    {
      "platform": "windows"
    }
  ],
  "supported_devices": [
    {
      "type": "dashboard_lcd",
      "features": [
        "sensor-screen"
      ]
    }
  ],
  "interactive": true,
  "permissions": [
    {
      "type": "microphone"
    },
    {
      "type": "application",
      "application": "Stream Deck"
    },
    {
      "type": "url",
      "domain": "open-meteo.com"
    },
    {
      "type": "url",
      "domain": "calendar.google.com"
    },
    {
      "type": "url",
      "domain": "rainviewer.com"
    },
    {
      "type": "url",
      "domain": "cartocdn.com"
    }
  ],
  "required_plugins": [
    "widgetbuilder.streamdeck:StreamDeck:1.2",
    "widgetbuilder.mediadataprovider:Media:1.1"
  ]
}
